<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Desenhar a bolha flutuante por cima dos outros apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Buscar a letra da musica (lrclib.net). Permissao normal, concedida na instalacao,
         sem dialogo nenhum pro usuario. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Manter o servico da bolha rodando de forma confiavel -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notificacao persistente do servico (obrigatoria a partir do Android 13) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reabrir a bolha sozinha depois que o celular reiniciar (se ja estava ligada) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AgoraTocando"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AgoraTocando"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Le o que esta tocando em qualquer app (Spotify, YouTube Music, etc), sem login.
             Precisa que o usuario ative "Acesso a notificacoes" nas Configuracoes do sistema. -->
        <service
            android:name=".MediaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Desenha a bolha flutuante. Precisa da permissao "Exibir sobre outros apps". -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_now_playing_bubble" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
