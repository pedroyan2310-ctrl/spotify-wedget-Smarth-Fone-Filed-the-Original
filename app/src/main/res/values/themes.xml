<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema sempre escuro, de propósito — a identidade visual do app não muda com o tema do sistema. -->
    <style name="Theme.AgoraTocando" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Deixa a capa do album na bolha expandida redonda, sem precisar de nenhum codigo extra -->
    <style name="ShapeAppearance.AgoraTocando.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
